@inherits LayoutComponentBase

<div class="min-h-screen w-full flex flex-col relative text-white">
    <!-- Top Horizontal Navigation -->
    <header class="w-full flex items-center justify-between px-8 py-5 z-20">
        <!-- Logo / Title -->
        <a href="/" class="text-2xl md:text-3xl font-bold text-amber-300 drop-shadow-[0_2px_2px_rgba(0,0,0,0.8)] tracking-wider hover:opacity-90">
            Stardewzzz
        </a>

        <!-- Horizontal Nav Links -->
        <nav class="flex items-center gap-6 text-sm md:text-base font-semibold">
            <NavLink href="characters" class="text-amber-200 hover:text-amber-400 drop-shadow transition-colors">
                characters
            </NavLink>
            <NavLink href="compatibility" class="text-amber-200 hover:text-amber-400 drop-shadow transition-colors">
                compatibility-matrix
            </NavLink>
        </nav>
    </header>

    <!-- Main Page Content -->
    <main class="flex-1 w-full flex flex-col">
        @Body
    </main>
</div>